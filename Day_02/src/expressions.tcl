puts "=========================================="
puts "        DAY 2 - EXPRESSIONS"
puts "=========================================="

#---------------------------------------------------------
# Arithmetic Expressions
#---------------------------------------------------------

puts "\nArithmetic Expressions"
puts "----------------------"

puts "10 + 20 = [expr {10 + 20}]"
puts "20 - 10 = [expr {20 - 10}]"
puts "5 * 6   = [expr {5 * 6}]"

#---------------------------------------------------------
# Integer vs Floating Point Division
#---------------------------------------------------------

puts "\nDivision"
puts "--------"

puts "20 / 7   = [expr {20 / 7}]"
puts "20.0 / 7 = [expr {20.0 / 7}]"

#---------------------------------------------------------
# Operator Precedence
#---------------------------------------------------------

puts "\nOperator Precedence"
puts "-------------------"

puts "10 + 20 * 5   = [expr {10 + 20 * 5}]"
puts "(10 + 20) * 5 = [expr {(10 + 20) * 5}]"

#---------------------------------------------------------
# Nested Expression
#---------------------------------------------------------

puts "\nNested Expression"
puts "-----------------"

set x 10
set y 20
set z 4

puts "((x + y) * z) = [expr {(($x + $y) * $z)}]"

puts "\n=========================================="
puts "Day 2 Expressions Completed"
puts "=========================================="
