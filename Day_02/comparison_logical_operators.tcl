#---------------------------------------------------------
# Comparison Operators
#---------------------------------------------------------

puts [expr {10 == 10}]    ;# True
puts [expr {10 != 5}]     ;# True
puts [expr {10 > 5}]      ;# True
puts [expr {10 <= 5}]     ;# False


#---------------------------------------------------------
# String Comparison
#---------------------------------------------------------

set company "NVIDIA"

puts [expr {$company eq "NVIDIA"}]    ;# True
puts [expr {$company ne "AMD"}]       ;# True


#---------------------------------------------------------
# Logical Operators
#---------------------------------------------------------

puts [expr {(10 > 5) && (20 > 15)}]   ;# True
puts [expr {(10 > 5) || (20 < 15)}]   ;# True
puts [expr {!(10 > 5)}]               ;# False
